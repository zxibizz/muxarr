# Copy to .env next to compose.yaml.

# Required. Radarr/Sonarr need the same value. Generate one with:
#   openssl rand -hex 32
MUXARR_TOKEN=change-me

# Required. The docker network your Radarr/Sonarr containers are on, e.g.
# media_default. Find it with: docker inspect radarr --format '{{json .NetworkSettings.Networks}}'
ARR_NETWORK=change-me

# compose.split.example.yaml only.
# MUXARR_DB_PASSWORD=change-me

# The uid/gid that owns your library. Must match the *arr containers' PUID/PGID.
PUID=1000
PGID=1000
