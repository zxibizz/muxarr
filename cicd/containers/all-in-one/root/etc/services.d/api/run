#!/command/with-contenv sh
# stderr onto stdout so s6-log captures uvicorn's access log and tracebacks alike.
exec 2>&1

cd /app
exec s6-applyuidgid -u "${PUID:-1000}" -g "${PGID:-1000}" \
    /app/.venv/bin/uvicorn --factory src.api.app:build_app \
        --host 127.0.0.1 \
        --port 8000 \
        --log-level "$(echo "${MUXARR_LOG_LEVEL:-INFO}" | tr '[:upper:]' '[:lower:]')"
