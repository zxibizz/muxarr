#!/bin/sh
# Runs "$@" as the uid that owns the library. Started as root (the PUID/PGID way)
# it drops with s6-applyuidgid. Started as that user already (`docker run --user`,
# Kubernetes runAsUser) there is nothing to drop, and nothing it could drop to:
# PUID/PGID do not apply and the command simply runs as the current user.
if [ "$(id -u)" = 0 ]; then
    exec /command/s6-applyuidgid -u "${PUID:-1000}" -g "${PGID:-1000}" "$@"
fi
exec "$@"
