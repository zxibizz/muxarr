#!/bin/sh
# Docker runs this outside s6, from the container's own environment.
case "${MUXARR_MODE:-all}" in
    worker)
        # As PUID (when started as root) so a SQLite database is never touched by root.
        export HOME=/config
        exec /usr/local/bin/muxarr-drop /app/.venv/bin/python -m src.cli worker-alive
        ;;
    *)
        exec curl -fsS http://127.0.0.1:8710/healthz
        ;;
esac
