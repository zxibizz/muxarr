#!/command/with-contenv sh
# stderr onto stdout so s6-log captures uvicorn's access log and tracebacks alike.
exec 2>&1

if [ "${MUXARR_MODE:-all}" = "worker" ]; then
    # Not part of this mode: stay down instead of being restarted forever.
    s6-svc -O .
    exit 0
fi

cd /app
# asyncpg probes ~/.postgresql, and root's HOME is unreadable once privileges drop.
export HOME=/config
exec s6-applyuidgid -u "${PUID:-1000}" -g "${PGID:-1000}" \
    /app/.venv/bin/uvicorn --factory src.api.app:build_app \
        --host 127.0.0.1 \
        --port 8000 \
        --log-level "$(echo "${MUXARR_LOG_LEVEL:-INFO}" | tr '[:upper:]' '[:lower:]')"
