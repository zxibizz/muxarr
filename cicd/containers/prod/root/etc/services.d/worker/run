#!/command/with-contenv sh
# The only process that muxes: it owns mkvmerge and the write side of the
# library. The API never touches either.
exec 2>&1

if [ "${MUXARR_MODE:-all}" = "web" ]; then
    # Not part of this mode: stay down instead of being restarted forever.
    s6-svc -O .
    exit 0
fi

cd /app
# asyncpg probes ~/.postgresql, and root's HOME is unreadable once privileges drop.
export HOME=/config
exec s6-applyuidgid -u "${PUID:-1000}" -g "${PGID:-1000}" \
    /app/.venv/bin/python -m src.worker
