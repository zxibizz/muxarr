# An outer TLS proxy's scheme, so the session cookie is marked Secure behind it.
map $http_x_forwarded_proto $muxarr_forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen 8710 default_server;
    listen [::]:8710 default_server;

    root /static;
    index index.html;

    # nginx would build redirects from its own :8710, which is wrong behind a port
    # mapping or a reverse proxy; a relative Location is right everywhere.
    absolute_redirect off;

    # The shim POSTs an absolute path per track; the default 1m is ample, but a
    # season pack with many sidecars is not worth a 413.
    client_max_body_size 4m;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json;

    # MUXARR_URL_BASE, written at start-up; empty when there is none.
    include /etc/nginx/muxarr/url-base.conf;

    # The API contract is unprefixed: shims in the wild already POST /v1/import.
    location /v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Appended: the API believes the chain only from MUXARR_TRUSTED_PROXIES,
        # and reads it from the right, so a client-written prefix is ignored.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $muxarr_forwarded_proto;

        # /v1/jobs/{id}/protocol holds the request open for up to
        # MUXARR_MAX_POLL_WAIT seconds. Anything below that turns a healthy
        # long-poll into a 504 and the shim fails a perfectly good import.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # The shim reads the body as it arrives; buffering defeats the point.
        proxy_buffering off;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    # Vite emits content-hashed asset names, so they can be cached forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
