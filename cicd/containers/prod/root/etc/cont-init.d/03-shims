#!/command/with-contenv sh
# Republishes the *arr-side shims into the directory the *arr containers mount, so
# an upgraded image cannot leave them running the shims of an older release.
# Deliberately not `set -e`: S6_BEHAVIOUR_IF_STAGE2_FAILS=2 would turn a
# read-only volume into a dead container, and a stale shim still muxes.

if [ "${MUXARR_MODE:-all}" = "worker" ]; then
    echo "shims: worker mode, the web container publishes them"
    exit 0
fi

if [ ! -d /shims ]; then
    echo "shims: /shims is not mounted, nothing to publish"
    exit 0
fi

failed=0
for src in /app/scripts/muxarr-import-*.sh; do
    name="$(basename "${src}")"
    tmp="/shims/.${name}.tmp"
    # An *arr may be executing the old copy right now and sh reads a script as
    # it runs it, so rename over it rather than truncating it underneath.
    if cp "${src}" "${tmp}" && chmod 0755 "${tmp}" && mv -f "${tmp}" "/shims/${name}"; then
        continue
    fi
    rm -f "${tmp}"
    failed=1
done

for old in /shims/muxarr-import-*.sh; do
    [ -e "${old}" ] || continue
    [ -e "/app/scripts/$(basename "${old}")" ] || rm -f "${old}"
done

if [ "${failed}" -ne 0 ]; then
    echo "shims: could not write to /shims (mounted read-only?) -- the *arr containers keep the shims they already have" >&2
else
    echo "shims published to /shims"
fi

exit 0
