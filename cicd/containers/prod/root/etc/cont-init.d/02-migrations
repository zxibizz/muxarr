#!/command/with-contenv sh
# Runs before any service starts. With S6_BEHAVIOUR_IF_STAGE2_FAILS=2 a failure
# here aborts the container rather than serving against an unmigrated schema.
set -e

cd /app
# asyncpg probes ~/.postgresql, and root's HOME is unreadable once privileges drop.
export HOME=/config
if [ "${MUXARR_MODE:-all}" = "worker" ]; then
    # The web container owns migrations; running them from both would race.
    exec muxarr-drop \
        /app/.venv/bin/python -m src.cli wait-for-schema --timeout 120
fi
exec muxarr-drop \
    /app/.venv/bin/alembic upgrade head
