#!/command/with-contenv sh
# The library is owned by the *arr uid, and muxarr creates the final file, so it
# has to run as that uid too. /config holds the history database.
set -e

if [ "$(id -u)" != 0 ]; then
    # Started as the library's uid already: PUID/PGID do not apply, nothing can be
    # chowned, and /config has to be writable as it is.
    if [ ! -w /config ]; then
        echo "/config is not writable by uid $(id -u); started without root, muxarr cannot fix that itself" >&2
        exit 1
    fi
    echo "muxarr running as $(id -u):$(id -g) (started as non-root; PUID/PGID ignored)"
    exit 0
fi

PUID="${PUID:-1000}"
PGID="${PGID:-1000}"

mkdir -p /config
chown "${PUID}:${PGID}" /config

echo "muxarr running as ${PUID}:${PGID}"
